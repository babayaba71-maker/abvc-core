{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission",
  "description": "La dosis del día: SECUENCIA de pasos con configuración de objetivo y criterios de terminación. No es un lesson ID, es un pipeline.",
  "type": "object",
  "required": ["mission_id", "student_id", "steps"],
  "properties": {
    "mission_id": { "type": "string" },
    "student_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "trigger_event": { "type": "string" },
    "primary_target_skill": { "type": "string", "description": "Skill path, ej: phonology.linking_connected_speech" },
    "secondary_target_skill": { "type": "string" },
    "teacher_override_active": { "type": "boolean", "default": false },
    "estimated_duration_minutes": { "type": "number" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_number", "tool_id"],
        "properties": {
          "step_number": { "type": "integer" },
          "tool_id": { "type": "string" },
          "mode": { "type": "string", "description": "ej: AUDITORY_DISCRIMINATION, VISUAL_LINKING_MAP, PRODUCTION_CHECK" },
          "target_configuration": {
            "type": "object",
            "description": "Parámetros inyectados en la herramienta: phrase, phoneme_pairs, difficulty (0-1), highlight_reductions, evaluation_strictness...",
            "additionalProperties": true
          },
          "completion_criteria": {
            "type": "object",
            "properties": {
              "minimum_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
              "intelligibility_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
              "max_attempts": { "type": "integer" },
              "interactive_nodes_completed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
